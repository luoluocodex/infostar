# ========== 依赖与构建产物 ==========
node_modules/
dist/
dist-ssr/
*.local

# ========== 测试与覆盖率 ==========
coverage/
.nyc_output/

# ========== Playwright 真实浏览器验证产物 ==========
e2e-report/
e2e-results/
playwright-report/
test-results/
.playwright-cli/

# ========== 环境变量与密钥 ==========
.env
.env.*
!.env.example
.htpasswd
*.pem
*.key

# ========== 编辑器与系统文件 ==========
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
desktop.ini
*.swp

# ========== 日志与临时文件 ==========
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tsbuildinfo
.eslintcache

# ========== 文档提取中间产物（可由 reference/ 复现，不入库） ==========
.workbuddy/_ref/

# 注：.workbuddy/memory/ 是项目长期记忆（决策与约定），默认纳入版本管理。
